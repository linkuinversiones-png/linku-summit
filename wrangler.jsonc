{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "linku-summit",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Plan Workers Paid (2026-09-23). Sin esto, nodos con la config vieja seguian
  // matando el render de la portada a los 10 ms del plan Free (error 1102).
  "limits": { "cpu_ms": 30000 },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "www.linkusummit.com", "custom_domain": true },
    { "pattern": "linkusummit.com", "custom_domain": true }
  ]
}
